{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mystline",
  "version": "1.1.0",
  "identifier": "local.mystline.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEMzNDNUNDMTk1NkMzQUUKUldTdXcxWVp6TVV6bmRISkdsbGgyQ2FjaGR0ZXRXckduT0J3aUZSRFlQM2FhVU15S3I2bWVucVcK",
      "endpoints": [
        "https://github.com/zemoa/Mystline/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
