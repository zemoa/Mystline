{
  "name": "mystline-ui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "tauri": "pnpm --dir .. run tauri",
    "desktop:dev": "pnpm --dir .. run desktop:dev",
    "desktop:build": "pnpm --dir .. run desktop:build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "vue": "^3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6",
    "typescript": "^5",
    "vite": "^7",
    "vue-tsc": "^3"
  }
}
